histdb-merge() {
    local source_url="${1:-}"
    if [[ -z "$source_url" ]]; then
        echo "Usage: histdb-merge <source_sqld_url>"
        echo "Example: histdb-merge http://remote-host:8080"
        return 1
    fi

    _histdb_init
    echo "Merging from $source_url..."

    local temp_file=$(mktemp)
    local body='{"baton":null,"requests":[{"type":"execute","stmt":{"sql":"SELECT argv, last_host, last_dir, wtime, status, count FROM cmd LIMIT 100000","args":[],"want_rows":true}}]}'

    curl -s -X POST "${source_url}/v3/pipeline" \
        -H "Content-Type: application/json" \
        -d "$body" | \
        jq -r '.results[0].response.result.rows[] | [.[] | if .type == "null" then "" elif .type == "integer" then .value else .value end] | @tsv' > "$temp_file" 2>/dev/null

    if [[ ! -s "$temp_file" ]]; then
        echo "No data to merge or connection failed"
        rm -f "$temp_file"
        return 1
    fi

    local total=$(wc -l < "$temp_file")
    echo "Merging $total entries..."
    local count=0
    while IFS=$'\t' read -r argv host dir wtime status cnt; do
        local argv_escaped=$(printf '%s' "$argv" | sed "s/'/''/g")
        local dir_escaped=$(printf '%s' "$dir" | sed "s/'/''/g")
        local host_escaped=$(printf '%s' "$host" | sed "s/'/''/g")
        status=${status:-0}
        wtime=${wtime:-0}
        cnt=${cnt:-1}

        _histdb_query "INSERT INTO cmd (argv, count, wtime, status, last_dir, last_host)
VALUES ('$argv_escaped', $cnt, $wtime, $status, '$dir_escaped', '$host_escaped')
ON CONFLICT(argv) DO UPDATE SET
    count = count + $cnt,
    wtime = max(wtime, excluded.wtime);"

        count=$((count + 1))
        if (( count % 100 == 0 )); then echo "  Merged $count..."; fi
    done < "$temp_file"

    rm -f "$temp_file"
    echo "Merge complete: $count entries merged"
}
