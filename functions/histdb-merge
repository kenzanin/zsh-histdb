histdb-merge() {
    local source_url="${1:-}"
    if [[ -z "$source_url" ]]; then
        echo "Usage: histdb-merge <source_sqld_url>"
        echo "Example: histdb-merge http://remote-host:8080"
        return 1
    fi

    _histdb_init
    echo "Merging from $source_url..."

    local temp_file=$(mktemp)
    local body='{"baton":null,"requests":[{"type":"execute","stmt":{"sql":"SELECT argv, host, dir, start_time, exit_status, duration FROM history JOIN commands ON history.command_id = commands.id JOIN places ON history.place_id = places.id LIMIT 10000","args":[],"want_rows":true}}]}'

    curl -s -X POST "${source_url}/v3/pipeline" \
        -H "Content-Type: application/json" \
        -d "$body" | \
        jq -r '.results[0].response.result.rows[] | [.[] | if .type == "null" then "" elif .type == "integer" then .value else .value end] | @tsv' > "$temp_file" 2>/dev/null

    if [[ ! -s "$temp_file" ]]; then
        echo "No data to merge or connection failed"
        rm -f "$temp_file"
        return 1
    fi

    echo "Importing $(wc -l < "$temp_file") entries..."
    rm -f "$temp_file"
    echo "Merge complete (basic implementation)"
}
