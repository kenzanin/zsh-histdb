histdb-info() {
    echo "=== zsh-histdb Info ==="
    echo ""

    echo "Plugin:"
    echo "  Source: ${HISTDB_INSTALLED_IN:-unknown}"
    local plugin_dir="${${HISTDB_INSTALLED_IN:A}:h}"
    echo "  Dir:    $plugin_dir"
    echo ""

    echo "Database:"
    echo "  Backend: sqld (libSQL server via Hrana3 HTTP)"
    local total=$(_histdb_query "SELECT count(*) FROM history" 2>/dev/null)
    local unique=$(_histdb_query "SELECT count(DISTINCT command_id) FROM history" 2>/dev/null)
    echo "  Records: ${total:-0} history entries, ${unique:-0} unique commands"
    echo ""

    echo "sqld (server):"
    local sqld_path
    sqld_path=$(which sqld 2>/dev/null)
    if [[ -n "$sqld_path" ]]; then
        local sqld_ver
        sqld_ver=$("$sqld_path" --version 2>&1 | head -3)
        echo "  Binary: $sqld_path"
        echo "$sqld_ver" | sed 's/^/  Version: /'
    else
        echo "  Binary: Not found in PATH"
    fi
    local sqld_addr="${HISTDB_LIBSQL_URL#http://}"
    sqld_addr="${sqld_addr%/}"
    echo "  Address: $sqld_addr"
    if curl -s -o /dev/null -w "%{http_code}" "$HISTDB_LIBSQL_URL/v3" >/dev/null 2>&1; then
        echo "  Status:  running (Hrana3)"
    else
        echo "  Status:  Connection failed"
    fi
    local systemd_active=$(systemctl --user is-active zshdb.service 2>/dev/null)
    echo "  Systemd: $systemd_active"
    echo ""

    echo "Client tools:"
    if which curl >/dev/null 2>&1; then
        echo "  curl:    $(curl --version 2>&1 | head -1 | awk '{print $2}')"
    else
        echo "  curl:    Not installed"
    fi
    if which jq >/dev/null 2>&1; then
        echo "  jq:      $(jq --version 2>&1)"
    else
        echo "  jq:      Not installed"
    fi
    if which fzf >/dev/null 2>&1; then
        echo "  fzf:     $(fzf --version 2>&1)"
    else
        echo "  fzf:     Not installed (histdb-fzf won't work)"
    fi
    if which bat >/dev/null 2>&1; then
        echo "  bat:     $(bat --version 2>&1)"
    else
        echo "  bat:     Not installed (preview without highlighting)"
    fi
    echo ""

    echo "Query mode:"
    echo "  Protocol: Hrana3 over HTTP (POST /v3/pipeline)"
    echo ""

    echo "SQLite extensions:"
    local ext_dir="${plugin_dir}/extension"
    if [[ -d "$ext_dir" ]]; then
        echo "  Dir:    $ext_dir"
        local count=$(ls "$ext_dir"/*.so 2>/dev/null | wc -l)
        echo "  Loaded: $count extension(s)"
        for ext in "$ext_dir"/*.so; do
            local ext_name="${ext##*/}"
            ext_name="${ext_name%.so}"
            echo "    - $ext_name"
        done
    else
        echo "  Dir:    Not found ($ext_dir)"
    fi
    echo ""

    echo "Environment:"
    echo "  HISTDB_LIBSQL_URL: ${HISTDB_LIBSQL_URL}"
    echo "  HISTDB_SESSION:    ${HISTDB_SESSION:-not initialized}"
    echo "  HISTDB_HOST:       ${HISTDB_HOST:-not set}"
    echo ""

    echo "Manual queries:"
    echo "  curl -s -X POST \"$HISTDB_LIBSQL_URL/v3/pipeline\" -H \"Content-Type: application/json\" -d '{\"baton\":null,\"requests\":[{\"type\":\"execute\",\"stmt\":{\"sql\":\"SELECT argv FROM commands LIMIT 5\",\"args\":[]}}]}' | jq ."
}
