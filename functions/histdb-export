histdb-export() {
    local format="${1:-text}"
    local output="${2:-}"
    _histdb_init

    local query="SELECT datetime(wtime, 'unixepoch', 'localtime') as time, last_host as host, last_dir as dir, argv as command, status, count FROM cmd ORDER BY wtime DESC"

    case "$format" in
        json)
            local json_query="SELECT json_object('time', datetime(wtime, 'unixepoch', 'localtime'), 'host', last_host, 'dir', last_dir, 'command', argv, 'status', status, 'count', count) FROM cmd ORDER BY wtime DESC LIMIT 10000"
            local result=$(_histdb_query "$json_query" | jq -s '.')
            if [[ -n "$output" ]]; then printf '%s\n' "$result" > "$output"
            else printf '%s\n' "$result"
            fi
            ;;
        text|*)
            if [[ -n "$output" ]]; then _histdb_query "$query" > "$output"
            else _histdb_query "$query"
            fi
            ;;
    esac
}
