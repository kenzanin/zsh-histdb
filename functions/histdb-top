histdb-top() {
    _histdb_init
    local sep=$'\x1f'
    local field
    local order="desc"
    local mode="${1:-cmd}"
    shift
    for arg in "$@"; do
        case "$arg" in
            --desc) order="desc" ;;
        esac
    done

    case "$mode" in
        dir) field="last_dir" ;;
        cmd) field="argv" ;;
    esac

    _histdb_query -separator "$sep" -header \
        "select count, last_host as host, replace($field, '
', '
$sep$sep') as $mode from cmd order by count $order" | \
        "${HISTDB_TABULATE_CMD[@]}"
}
