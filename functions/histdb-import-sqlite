histdb-import-sqlite() {
    local sqlite_file="${1:-$HOME/.histdb.db}"
    if [[ ! -f "$sqlite_file" ]]; then
        echo "Usage: histdb-import-sqlite <sqlite_db_path>"
        echo "Default: $HOME/.histdb.db"
        return 1
    fi

    _histdb_init
    echo "Importing from $sqlite_file..."

    local temp_file=$(mktemp)
    sqlite3 "$sqlite_file" <<-EOSQL
.mode tabs
.output $temp_file
SELECT commands.argv, places.host, places.dir, 
       history.start_time,
       CASE WHEN history.exit_status IS NULL THEN 0 ELSE history.exit_status END
FROM history 
JOIN commands ON history.command_id = commands.id 
JOIN places ON history.place_id = places.id 
ORDER BY history.start_time
LIMIT 100000;
EOSQL

    if [[ ! -s "$temp_file" ]]; then
        echo "No data to import"
        rm -f "$temp_file"
        return 1
    fi

    echo "Importing $(wc -l < "$temp_file") records..."
    local count=0
    while IFS=$'\t' read -r argv host dir start_time status; do
        local cmd_escaped=$(printf '%s' "$argv" | sed "s/'/''/g")
        local dir_escaped=$(printf '%s' "$dir" | sed "s/'/''/g")
        local host_escaped=$(printf '%s' "$host" | sed "s/'/''/g")
        local status=${status:-0}
        local start_time=${start_time:-0}

        _histdb_query "INSERT INTO cmd (argv, count, wtime, status, last_dir, last_host)
VALUES ('$cmd_escaped', 1, $start_time, $status, '$dir_escaped', '$host_escaped')
ON CONFLICT(argv) DO UPDATE SET
    count = count + 1,
    wtime = max(wtime, excluded.wtime),
    status = excluded.status,
    last_dir = excluded.last_dir,
    last_host = excluded.last_host;"

        count=$((count + 1))
        if (( count % 100 == 0 )); then echo "Imported $count records..."; fi
    done < "$temp_file"

    rm -f "$temp_file"
    echo "Import complete: $count records"
}
