histdb () {
    _histdb_init
    local -a hosts
    local -a indirs
    local -a atdirs

    zparseopts -E -D -a opts \
               -host+::=hosts \
               -in+::=indirs \
               -at+::=atdirs \
               -detail \
               -sep:- \
               -exact \
               d h -help \
               -from:- -until:- -limit:- \
               -status:- -desc

    local usage="usage:$0 terms [--desc] [--host[ x]] [--in[ x]] [--at[ x]] [-d] [--detail] [--exact] [--sep x] [--from x] [--until x] [--limit n] [--status x]
    --desc     reverse sort order of results
    --host     print the host column and show all hosts (otherwise current host)
    --host x   find entries from host x
    --in       find only entries run in the current dir or below
    --in x     find only entries in directory x or below
    --at       like --in, but excluding subdirectories
    -d         debug output query that will be run
    --detail   show details (status, count)
    --exact    don't match substrings
    --sep x    print with separator x, and don't tabulate
    --from x   only show commands after date x (sqlite date parser)
    --until x  only show commands before date x (sqlite date parser)
    --limit n  only show n rows. defaults to \$LINES or 25
    --status x only show rows with exit status x. Can be 'error' to find all nonzero."

    local dircol="replace(last_dir, '\$HOME', '~') as dir"
    local where="1"
    if [[ -p /dev/stdout ]]; then
        local limit=""
    else
        local limit="${$((LINES - 4)):-25}"
    fi

    local exact=0

    if (( ${#hosts} )); then
        local hostwhere=""
        local host=""
        for host ($hosts); do
            host="${${host#--host}#=}"
            hostwhere="${hostwhere}${host:+${hostwhere:+ or }last_host='$(sql_escape ${host})'}"
        done
        where="${where}${hostwhere:+ and (${hostwhere})}"
        dircol="${dircol}, last_host as host"
    else
        where="${where} and last_host='$(sql_escape ${HOST})'"
    fi

    if (( ${#indirs} + ${#atdirs} )); then
        local dirwhere=""
        local dir=""
        for dir ($indirs); do
            dir="${${${dir#--in}#=}:-$PWD}"
            dirwhere="${dirwhere}${dirwhere:+ or }last_dir like '$(sql_escape $dir)%'"
        done
        for dir ($atdirs); do
            dir="${${${dir#--at}#=}:-$PWD}"
            dirwhere="${dirwhere}${dirwhere:+ or }last_dir = '$(sql_escape $dir)'"
        done
        where="${where}${dirwhere:+ and (${dirwhere})}"
    fi

    local sep=$'\x1f'
    local orderdir='asc'
    local debug=0
    local opt=""
    for opt ($opts); do
        case $opt in
            --desc)
                orderdir='desc'
                ;;
            --sep*)
                sep=${opt#--sep}
                ;;
            --from*)
                local from=${opt#--from}
                case $from in
                    -*) from="datetime('now', '$from')" ;;
                    today) from="datetime('now', 'start of day')" ;;
                    yesterday) from="datetime('now', 'start of day', '-1 day')" ;;
                esac
                where="${where} and datetime(wtime, 'unixepoch') >= $from"
                ;;
            --status*)
                local xstatus=${opt#--status}
                case $xstatus in
                    <->) where="${where} and status = $xstatus" ;;
                    error) where="${where} and (status is NULL or status <> 0)" ;;
                esac
                ;;
            --until*)
                local until=${opt#--until}
                case $until in
                    -*) until="datetime('now', '$until')" ;;
                    today) until="datetime('now', 'start of day')" ;;
                    yesterday) until="datetime('now', 'start of day', '-1 day')" ;;
                esac
                where="${where} and datetime(wtime, 'unixepoch') <= $until"
                ;;
            -d) debug=1 ;;
            --detail)
                dircol="${dircol}, status, count "
                ;;
            -h|--help) echo "$usage"; return 0 ;;
            --exact) exact=1 ;;
            --limit*) limit=${opt#--limit} ;;
        esac
    done

    if [[ -n "$*" ]]; then
        if (( !exact )); then
            where="${where} and argv glob '*$(sql_escape "$@")*'"
        else
            where="${where} and argv = '$(sql_escape "$@")'"
        fi
    fi

    local seps=$(echo "$dircol" | tr -c -d ',' | tr ',' $sep)
    dircol="${dircol}, replace(argv, '
', '
$seps') as argv, wtime as max_start"

    local mst="datetime(max_start, 'unixepoch')"
    local dst="datetime('now', 'start of day')"
    local timecol="strftime(case when $mst > $dst then '%H:%M' else '%d/%m' end, max_start, 'unixepoch', 'localtime') as time"
    local selcols="${timecol}, ${dircol}"

    local query="select ${selcols} from cmd
where ${where}
order by max_start ${orderdir}
${limit:+limit $limit}"

    if (( debug )); then
        echo "$query"
    else
        local count=$(_histdb_query "select count(*) from cmd where ${where}")
        if [[ -p /dev/stdout ]]; then
            buffer() { local t=$(mktemp); cat >! "$t"; cat -- "$t"; rm -f -- "$t" }
        else
            buffer() { cat }
        fi
        if [[ $sep == $'\x1f' ]]; then
            _histdb_query -header -separator $sep "$query" | iconv -f utf-8 -t utf-8 -c | buffer | "${HISTDB_TABULATE_CMD[@]}"
        else
            _histdb_query -header -separator $sep "$query" | buffer
        fi
        [[ -n $limit ]] && [[ $limit -lt $count ]] && echo "(showing $limit of $count results)"
    fi
}
