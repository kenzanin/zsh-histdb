histdb-stats() {
    _histdb_init
    echo "=== History Statistics ==="
    echo ""

    local total=$(_histdb_query "SELECT count(*) FROM cmd")
    echo "Total entries: $total"

    local unique=$(_histdb_query "SELECT count(*) FROM cmd")
    echo "Unique commands: $unique"

    echo ""
    echo "Most active hosts:"
    _histdb_query -separator $'\t' -header "SELECT last_host as host, count(*) as count FROM cmd GROUP BY last_host ORDER BY count DESC LIMIT 5"

    echo ""
    echo "Most active directories:"
    _histdb_query -separator $'\t' -header "SELECT last_dir as dir, count(*) as count FROM cmd GROUP BY last_dir ORDER BY count DESC LIMIT 5"

    echo ""
    echo "Command usage (count distribution):"
    _histdb_query -separator $'\t' -header "SELECT avg(count) as avg, max(count) as max, sum(count) as total FROM cmd WHERE count > 0"

    echo ""
    echo "Most active hours:"
    _histdb_query -separator $'\t' -header "SELECT strftime('%H', datetime(wtime, 'unixepoch', 'localtime')) as hour, count(*) as count FROM cmd GROUP BY hour ORDER BY count DESC LIMIT 5"
}
