# Test setup - sourced before each test file

source "${0:A:h}/../../libsql-history.zsh"
source "${0:A:h}/../../libsql-history-autosuggest.zsh"

# Source autoloaded functions for testing (normally lazy-loaded)
source "${0:A:h}/../../functions/histdb"
source "${0:A:h}/../../functions/histdb-top"
source "${0:A:h}/../../functions/histdb-search"
source "${0:A:h}/../../functions/histdb-stats"
source "${0:A:h}/../../functions/histdb-export"

# Override _histdb_query to use local SQLite3 for testing
typeset -g TEST_DB=""
typeset -g TEST_QUERY_COUNT=0

_histdb_test_init() {
    if [[ -z "$TEST_DB" ]]; then
        TEST_DB=$(mktemp /tmp/zsh-histdb-test-XXXXXX.db)
        sqlite3 "$TEST_DB" <<-EOF
create table cmd (argv text unique, count int default 1, wtime int, status int, last_dir text, last_host text);
create index cmd_wtime on cmd(wtime);
create index cmd_argv on cmd(argv);
create index cmd_count on cmd(count);
EOF
        sqlite3 "$TEST_DB" <<-EOF
INSERT INTO cmd (argv, count, wtime, status, last_dir, last_host) VALUES
('ls -la',       1, 1714800000, 0, '/home/test', 'testhost'),
('cd /home',     1, 1714800100, 0, '/home/test', 'testhost'),
('git status',   1, 1714800200, 1, '/tmp',       'testhost'),
('vim file.txt', 1, 1714800300, 0, '/home/test', 'testhost'),
('ps aux',       1, 1714800400, 0, '/var/log',   'testhost'),
('ping google.com', 1, 1714800500, 0, '/home/test', 'testhost'),
('docker ps',    1, 1714800600, 0, '/tmp',       'testhost'),
('npm test',     1, 1714800700, 0, '/home/test', 'testhost'),
('cargo build',  1, 1714800800, 0, '/var/log',   'testhost'),
('python script.py', 1, 1714800900, 0, '/home/test', 'testhost');
EOF
    fi
}

_histdb_test_cleanup() {
    [[ -n "$TEST_DB" ]] && rm -f "$TEST_DB" && TEST_DB=""
}

_histdb_query() {
    _histdb_test_init
    TEST_QUERY_COUNT=$((TEST_QUERY_COUNT + 1))
    local separator=$'\t'
    local header=0
    local sql=""

    local -a args
    args=("$@")
    local i=1
    while (( i <= $#args )); do
        case "${args[$i]}" in
            -separator) separator="${args[$((i+1))]}"; i=$((i+2)) ;;
            -header) header=1; i=$((i+1)) ;;
            -noheader) header=0; i=$((i+1)) ;;
            -batch) i=$((i+1)) ;;
            -cmd) i=$((i+2)) ;;
            *) sql="${args[$i]}"; i=$((i+1)) ;;
        esac
    done

    [[ -z "$sql" ]] && return 0
    [[ -z "$TEST_DB" ]] && return 0

    if (( header )); then
        sqlite3 -header -separator "$separator" "$TEST_DB" "$sql" 2>/dev/null
    else
        sqlite3 -separator "$separator" "$TEST_DB" "$sql" 2>/dev/null
    fi
}

# Also override batch to use local sqlite3
_histdb_query_batch() {
    local sql
    sql="$(cat)"
    [[ -z "$sql" ]] && return 0
    _histdb_test_init
    sqlite3 -separator $'\t' "$TEST_DB" "$sql" 2>/dev/null
}

HOST=testhost

teardown() {
    _histdb_test_cleanup
}
