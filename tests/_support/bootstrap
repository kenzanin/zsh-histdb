# Test setup - sourced before each test file

source "${0:A:h}/../../rqlite-history.zsh"
source "${0:A:h}/../../rqlite-history-autosuggest.zsh"

# Source autoloaded functions for testing (normally lazy-loaded)
source "${0:A:h}/../../functions/histdb"
source "${0:A:h}/../../functions/histdb-top"
source "${0:A:h}/../../functions/histdb-search"
source "${0:A:h}/../../functions/histdb-stats"
source "${0:A:h}/../../functions/histdb-export"

# Override _histdb_query to use local SQLite3 for testing
typeset -g TEST_DB=""
typeset -g TEST_QUERY_COUNT=0

_histdb_test_init() {
    if [[ -z "$TEST_DB" ]]; then
        TEST_DB=$(mktemp /tmp/zsh-histdb-test-XXXXXX.db)
        sqlite3 "$TEST_DB" <<-EOF
create table commands (id integer primary key autoincrement, argv text, unique(argv) on conflict ignore);
create table places   (id integer primary key autoincrement, host text, dir text, unique(host, dir) on conflict ignore);
create table history  (id integer primary key autoincrement,
                       session int,
                       command_id int references commands (id),
                       place_id int references places (id),
                       exit_status int,
                       start_time int,
                       duration int);
PRAGMA user_version = 2;
EOF
        sqlite3 "$TEST_DB" <<-EOF
INSERT OR IGNORE INTO commands (argv) VALUES ('ls -la'), ('cd /home'), ('git status'), ('vim file.txt'), ('ps aux'), ('ping google.com'), ('docker ps'), ('npm test'), ('cargo build'), ('python script.py');
INSERT OR IGNORE INTO places (host, dir) VALUES ('testhost', '/home/test'), ('testhost', '/tmp'), ('testhost', '/var/log');
INSERT INTO history (session, command_id, place_id, start_time, exit_status, duration) VALUES
(1, 1, 1, 1714800000, 0, 2),
(1, 2, 1, 1714800100, 0, 5),
(1, 3, 2, 1714800200, 1, 1),
(1, 4, 1, 1714800300, 0, 30),
(1, 5, 3, 1714800400, 0, 3),
(1, 6, 1, 1714800500, 0, 10),
(1, 7, 2, 1714800600, 0, 8),
(1, 8, 1, 1714800700, 0, 15),
(1, 9, 3, 1714800800, 0, 60),
(1, 10, 1, 1714800900, 0, 4);
EOF
    fi
}

_histdb_test_cleanup() {
    [[ -n "$TEST_DB" ]] && rm -f "$TEST_DB" && TEST_DB=""
}

_histdb_query() {
    _histdb_test_init
    TEST_QUERY_COUNT=$((TEST_QUERY_COUNT + 1))
    local separator=$'\t'
    local header=0
    local sql=""

    local -a args
    args=("$@")
    local i=1
    while (( i <= $#args )); do
        case "${args[$i]}" in
            -separator) separator="${args[$((i+1))]}"; i=$((i+2)) ;;
            -header) header=1; i=$((i+1)) ;;
            -noheader) header=0; i=$((i+1)) ;;
            -batch) i=$((i+1)) ;;
            -cmd) i=$((i+2)) ;;
            *) sql="${args[$i]}"; i=$((i+1)) ;;
        esac
    done

    [[ -z "$sql" ]] && return 0
    [[ -z "$TEST_DB" ]] && return 0

    if (( header )); then
        sqlite3 -header -separator "$separator" "$TEST_DB" "$sql" 2>/dev/null
    else
        sqlite3 -separator "$separator" "$TEST_DB" "$sql" 2>/dev/null
    fi
}

HISTDB_SESSION=1
HISTDB_HOST="'testhost'"

teardown() {
    _histdb_test_cleanup
}
