#!/usr/bin/env zunit

@describe '_histdb_init database initialisation'

@test 'init creates cmd table' {
    local result
    result=$(_histdb_query "SELECT name FROM sqlite_master WHERE type='table' ORDER BY name")
    assert "$result" equals "cmd"
}

@test 'init creates indexes' {
    local result
    result=$(_histdb_query "SELECT name FROM sqlite_master WHERE type='index' ORDER BY name")
    assert "$result" contains "cmd_wtime"
    assert "$result" contains "cmd_argv"
    assert "$result" contains "cmd_count"
}

@test 'init is idempotent (can be called twice)' {
    local first
    first=$(_histdb_query "SELECT count(*) FROM cmd")

    _HISTDB_INITIALIZED=""
    _histdb_init

    local second
    second=$(_histdb_query "SELECT count(*) FROM cmd")
    assert "$second" equals "$first"
}

@test 'init does not crash when no HISTDB_HOST set' {
    _HISTDB_INITIALIZED=""
    _histdb_init
    assert "$status" equals 0
}
