#!/usr/bin/env zunit

@describe 'History hooks (_histdb_addhistory, _histdb_update_outcome)'

@setup {
    _histdb_init
}

@test 'boring prefix list is configured' {
    assert "${#_BORING_PREFIX}" equals "4"
    assert "$_BORING_PREFIX[1]" equals " "
    assert "$_BORING_PREFIX[2]" equals "histdb"
    assert "$_BORING_PREFIX[3]" equals "ls"
    assert "$_BORING_PREFIX[4]" equals "cd"
}

@test 'insert via _histdb_query batch works (cmd table)' {
    _histdb_query_batch <<EOF
INSERT INTO cmd (argv, count, wtime, last_dir, last_host)
VALUES ('echo save_test_cmd', 1, 1714800000, '/tmp', 'testhost')
ON CONFLICT(argv) DO UPDATE SET
    count = count + 1,
    wtime = excluded.wtime,
    last_dir = excluded.last_dir,
    last_host = excluded.last_host;
EOF

    local result
    result=$(_histdb_query "SELECT argv FROM cmd WHERE argv = 'echo save_test_cmd'")
    assert "$result" contains "save_test_cmd"
}

@test 'basic insert via _histdb_query works (cmd table)' {
    _histdb_query "INSERT INTO cmd (argv, count, wtime, last_dir, last_host) VALUES ('test_direct_insert', 1, 1714800000, '/tmp', 'testhost')"
    local result
    result=$(_histdb_query "SELECT argv FROM cmd WHERE argv = 'test_direct_insert'")
    assert "$result" equals "test_direct_insert"
}

@test '_histdb_addhistory function exists' {
    assert "$(typeset -f _histdb_addhistory)" is_not_empty
}

@test '_histdb_update_outcome function exists' {
    assert "$(typeset -f _histdb_update_outcome)" is_not_empty
}

@test '_histdb_addhistory can be called' {
    _histdb_addhistory $'some_test_command\n'
    assert "$?" equals "0"
}
