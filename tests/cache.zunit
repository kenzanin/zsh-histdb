#!/usr/bin/env zunit

@describe '_histdb_cache'

@test 'stores and retrieves values' {
  _histdb_cache_set key1 value1
  local result=$(_histdb_cache_get key1)
  assert "$result" contains "value1"
}

@test 'returns empty for missing keys' {
  local result=$(_histdb_cache_get nonexistent)
  assert "$result" is_empty
}

@test 'cache stores over 100 entries without errors' {
  local i
  for i in {1..105}; do
    _histdb_cache_set key$i value$i
  done
  local result=$(_histdb_cache_get key105)
  assert "$result" contains "value105"
}

@test 'clears cache when full' {
  local i
  for i in {1..101}; do
    _histdb_cache_set key$i value$i
  done
  local result=$(_histdb_cache_get key1)
  assert "$result" is_empty
}
